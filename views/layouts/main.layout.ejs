<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>
    <%= typeof title !=='undefined' ? title : 'App' %>
  </title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">

  <style>
    :root {
      --bs-primary: #0D1B3D;
      --bs-primary-rgb: 13, 27, 61;
      --bs-primary-bg-subtle: #1a3a6c;
      --bs-primary-border-subtle: #0D1B3D;
      --bs-primary-text-emphasis: #0D1B3D;
    }
  </style>
</head>

<body class="container bg-primary">
  <div class="d-block d-sm-none">
    <h1 class="display-1 text-center mt-5">XS</h1>
    <p class="text-center text-muted">&lt; 576px</p>
  </div>

  <!-- SM: แสดงแค่ช่วง SM -->
  <div class="d-none d-sm-block d-md-none">
    <h1 class="display-1 text-center mt-5">SM</h1>
    <p class="text-center text-muted">576px - 767px</p>
  </div>

  <!-- MD: แสดงแค่ช่วง MD -->
  <div class="d-none d-md-block d-lg-none">
    <h1 class="display-1 text-center mt-5">MD</h1>
    <p class="text-center text-muted">768px - 991px</p>
  </div>

  <!-- LG: แสดงแค่ช่วง LG -->
  <div class="d-none d-lg-block d-xl-none">
    <h1 class="display-1 text-center mt-5">LG</h1>
    <p class="text-center text-muted">992px - 1199px</p>
  </div>

  <!-- XL: แสดงแค่ช่วง XL -->
  <div class="d-none d-xl-block d-xxl-none">
    <h1 class="display-1 text-center mt-5">XL</h1>
    <p class="text-center text-muted">1200px - 1399px</p>
  </div>

  <!-- XXL: แสดงตอนหน้าจอใหญ่กว่า XL -->
  <div class="d-none d-xxl-block">
    <h1 class="display-1 text-center mt-5">XXL</h1>
    <p class="text-center text-muted">≥ 1400px</p>
  </div>
  <%- body %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>

</html>